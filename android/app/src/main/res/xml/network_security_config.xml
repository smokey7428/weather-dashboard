<?xml version="1.0" encoding="utf-8"?>
<!-- Every request this app makes is HTTPS. Cleartext is refused outright, so a
     downgrade attack cannot be used to observe the weather requests. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
